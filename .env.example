# Supabase → Project Settings → Database
# DATABASE_URL = Transaction pooler (port 6543)
# DIRECT_URL   = Direct connection or Session pooler (port 5432)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@HOST:5432/postgres"

AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Mobile REST API (src/app/api/v1/**)
# Separate secret from AUTH_SECRET so the web session JWTs and the mobile API JWTs
# can be rotated independently. Generate with: openssl rand -base64 32
API_JWT_SECRET="replace-with-a-different-long-random-string"

# Comma-separated allow-list of browser origins allowed to call /api/v1/** with
# credentials (CORS). Native apps and server-to-server calls send no Origin header
# and are always allowed through. Any https://*.vercel.app preview origin is also
# auto-allowed. Defaults to the Expo/Metro dev server origins if unset.
MOBILE_APP_ORIGIN="http://localhost:8081,http://localhost:19006"
