# Supabase → Project Settings → Database
# DATABASE_URL = Transaction pooler (port 6543)
# DIRECT_URL   = Direct connection or Session pooler (port 5432)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@HOST:5432/postgres"

PORT=3000

# Separate secret from the dashboard's AUTH_SECRET so the two token systems can be
# rotated independently. Generate with: openssl rand -base64 32
API_JWT_SECRET="replace-with-a-long-random-string"

# Comma-separated allow-list of browser origins allowed to call this API with
# credentials (CORS). Native apps and server-to-server calls send no Origin header
# and are always allowed through. Any https://*.vercel.app preview origin is also
# auto-allowed. Includes the dashboard's own dev origin (port 5173) by default.
CORS_ORIGIN="http://localhost:5173,http://localhost:8081,http://localhost:19006"
